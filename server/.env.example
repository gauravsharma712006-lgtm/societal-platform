# Replace every angle-bracket placeholder. Do not commit a filled .env.
NODE_ENV=production
PORT=5000
HOST=127.0.0.1
TRUST_PROXY=loopback
MONGODB_URI=<MONGODB_ATLAS_CONNECTION_URI>
JWT_SECRET=<RANDOM_PRODUCTION_SECRET_AT_LEAST_32_BYTES>
JWT_ISSUER=<APPLICATION_ISSUER>
JWT_AUDIENCE=<WEB_CLIENT_AUDIENCE>
JWT_ACCESS_TOKEN_TTL_SECONDS=28800
CORS_ORIGIN=https://<FRONTEND_DOMAIN>
AWS_REGION=<AWS_REGION>
AWS_S3_BUCKET_NAME=<PRIVATE_MEDIA_BUCKET>
# Prefer an EC2 instance role. Omit these with the AWS default credential chain.
# AWS_ACCESS_KEY_ID=<LOCAL_OR_TEMPORARY_ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<LOCAL_OR_TEMPORARY_SECRET_ACCESS_KEY>
# AWS_SESSION_TOKEN=<TEMPORARY_SESSION_TOKEN>
AI_ENABLED=false
# Optional; ignored for requests when AI_ENABLED=false. Keep Ollama private.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
